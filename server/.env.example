PORT=4000
APP_URL=http://localhost:4000
# Set to the Vite dev server URL (e.g. http://localhost:5173) during local development,
# since the client and server run on different ports there. Leave blank in production —
# the server serves the built client from the same origin, so a relative redirect is correct.
CLIENT_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cepatkan_bayar
JWT_SECRET=change-me-to-a-long-random-string
# Optional — without these, magic links are logged to the console instead of emailed
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# LLM Vision OCR API Provider Configuration
VISION_LLM_PROVIDER=claude
VISION_LLM_API_KEY=

