# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cepatkan_bayar

# Auth & Security
JWT_SECRET=supersecret_jwt_key
PORT=3000
NODE_ENV=production

# Cloudinary Cloud Storage (Rekomendasi - 100% Gratis Tanpa Kartu Kredit)
# Dapatkan di dashboard https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Atau gunakan format single connection string jika ada:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Cloudflare R2 Object Storage (Alternatif S3 - Optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cepatbayar
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
